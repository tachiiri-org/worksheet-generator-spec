%% レイアウトテンプレート.mmd
%% 同一行内のコメントアウトは認識されません
%% （）は使用禁止

classDiagram

%% =========================
%% Template（静的：枠と座標）
%% =========================

class レイアウトテンプレート {
  <<entity>>
  レイアウトテンプレートID
  方眼紙
  配置枠定義一覧
}

class 方眼紙 {
  <<value>>
  列数
  行数
}

class 配置枠定義 {
  <<value>>
  配置枠キー
  座標
  表示面
  枠種別
  既定フォント上書き
}

class 配置枠キー {
  <<value>>
  値
}

class 座標 {
  <<value>>
  上端
  左端
  幅
  高さ
}

class 表示面 {
  <<enum>>
  問題面
  解答面
}

%% 枠の“能力”のみをテンプレに置く（具体はInstance側）
class 枠種別 {
  <<enum>>
  テキスト枠
  画像枠
}

class フォント仕様 {
  <<value>>
  書体名
  太さ
  文字サイズpt
  行間倍率
}

%% =========================
%% 関係
%% =========================

レイアウトテンプレート --> 方眼紙
レイアウトテンプレート --> 配置枠定義

配置枠定義 --> 配置枠キー
配置枠定義 --> 座標
配置枠定義 --> 表示面
配置枠定義 --> 枠種別
配置枠定義 --> フォント仕様

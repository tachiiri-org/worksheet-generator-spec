%% 配布.mmd
%% 同一行内のコメントアウトは認識されません
%% （）は使用禁止

classDiagram

%% =========================
%% 配布（Distribution）境界
%% =========================

class 配布教材 {
  <<entity>>
  配布教材ID
  元公開教材参照
  配布方針
  スロット割当一覧
  作成日時
}

class 公開教材参照 {
  <<value>>
  公開教材ID
}

class 配布方針 {
  <<value>>
  期限付きリンク
  鍵方式
  QR表示
  ロゴ差し替え
}

class QR表示 {
  <<enum>>
  表示
  非表示
}

%% =========================
%% スロット割当
%% slotキー -> 実体（配布が意味を決める）
%% =========================

class スロット割当 {
  <<value>>
  スロットキー
  実体
}

class スロットキー {
  <<value>>
  値
}

class 実体 {
  <<value>>
  kind
}

class 実体種別 {
  <<enum>>
  テキスト
  画像
}

実体 --> 実体種別

class テキスト実体 {
  <<value>>
  本文
}

class 画像実体 {
  <<value>>
  画像データ参照
}

%% 画像データは配布が生成する（QR画像など含む）
class 画像データ参照 {
  <<value>>
  アセットID
  内容ハッシュ
  MIME種別
}

実体 --> テキスト実体
実体 --> 画像実体

%% =========================
%% 関係
%% =========================

配布教材 --> 公開教材参照
配布教材 --> 配布方針
配布教材 --> スロット割当

スロット割当 --> スロットキー
スロット割当 --> 実体
画像実体 --> 画像データ参照
配布方針 --> QR表示
